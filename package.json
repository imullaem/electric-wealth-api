{
  "name": "electric-wealth-api",
  "version": "0.1.0",
  "private": true,
  "description": "Electric Wealth REST API (Express + TypeScript) backed by the electric-wealth-db SQLite database.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch --import tsx src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:openapi": "node --import tsx scripts/openapi.ts",
    "check:openapi": "node --import tsx scripts/openapi.ts --check",
    "verify": "npm run typecheck && npm run check:openapi && npm test"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  },
  "allowScripts": {
    "esbuild": true,
    "@scarf/scarf": false,
    "fsevents": false
  },
  "scarfSettings": {
    "enabled": false
  }
}
